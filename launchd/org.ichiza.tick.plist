<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 時計のひと回り。誰も呼ばなくても回る——何度回しても同じ結果。 -->
  <key>Label</key><string>org.ichiza.tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>--project</string>
    <string>/Users/hashimototakashi/Ichiza</string>
    <string>python</string>
    <string>/Users/hashimototakashi/Ichiza/main.py</string>
    <string>tick</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/hashimototakashi/Ichiza</string>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/hashimototakashi/Ichiza/data/logs/tick.log</string>
  <key>StandardErrorPath</key><string>/Users/hashimototakashi/Ichiza/data/logs/tick.log</string>
</dict>
</plist>
