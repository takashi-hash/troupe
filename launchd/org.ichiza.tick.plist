<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 時計のひと回り。誰も呼ばなくても回る——何度回しても同じ結果。 -->
  <key>Label</key><string>org.ichiza.tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string>
    <string>run</string>
    <string>--project</string>
    <string>__ROOT__</string>
    <string>python</string>
    <string>__ROOT__/main.py</string>
    <string>tick</string>
  </array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <!-- 心拍は60秒。加えて帳簿（WAL）が変わった瞬間にも起きる——
       呼ばれずに来る、の実装。空振りは書かないので連鎖はすぐ静まる
       （launchd の既定 ThrottleInterval 10秒が暴走も防ぐ）。 -->
  <key>StartInterval</key><integer>60</integer>
  <key>WatchPaths</key>
  <array><string>__ROOT__/data/ichiza.db-wal</string></array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__ROOT__/data/logs/tick.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/data/logs/tick.log</string>
</dict>
</plist>
